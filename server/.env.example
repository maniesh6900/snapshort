# Server
PORT=8787
# Shared passcode every team member types into the app
TEAM_PASSCODE=letmein
# Any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Google Drive (OAuth desktop client + one-time refresh token)
# Get these with:  npm run drive:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# id of the ONE shared folder (from https://drive.google.com/drive/folders/<ID>)
# Each uploader gets a subfolder inside it, named after them.
DRIVE_FOLDER_ID=